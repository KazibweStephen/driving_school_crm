{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/m/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/m/index.html",
          "/m/manifest.webmanifest",
          "/m/*.css",
          "/m/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/m/icons/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": [
        "/api/**"
      ],
      "cacheConfig": {
        "maxSize": 0,
        "maxAge": "0s",
        "strategy": "freshness"
      }
    }
  ]
}
